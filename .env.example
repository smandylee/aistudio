# 시로(PM)가 팀 서버를 부를 때 쓰는 비밀 토큰. 시로의 TEAM_SERVER_TOKEN과 같은 값.
# 만들기: openssl rand -hex 32
TEAM_SERVER_TOKEN=

# 팀 채널의 웹후크 URL (채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사)
TEAM_WEBHOOK_URL=

# Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 서비스 계정 키 파일 (로컬에서 gcloud auth application-default login을 했다면 비워둬도 됨)
GOOGLE_APPLICATION_CREDENTIALS=

# 듣는 주소. 시로와 같은 VM이면 그대로 둔다.
TEAM_SERVER_HOST=127.0.0.1
TEAM_SERVER_PORT=18791

# 팀원 모델 (Vertex 모델 ID). 404가 나면 Model Garden에서 정확한 ID를 확인해서 바꾼다.
TEAM_RESEARCH_MODEL=gemini-3.8-flash
TEAM_WRITER_MODEL=claude-opus-5-5
TEAM_REVIEW_MODEL=gemini-3.1-pro-preview
TEAM_DESIGN_MODEL=gemini-3-pro-image-preview
