# PM 봇 토큰 (디스코드 개발자 포털 → 새 애플리케이션 → Bot → Reset Token).
# Bot 설정에서 MESSAGE CONTENT INTENT를 켜야 메시지를 읽는다.
PM_BOT_TOKEN=

# 팀 채널 ID와, PM이 일을 받아줄 사람(주인님)의 디스코드 사용자 ID. 여럿이면 쉼표로.
# 개발자 모드 켜고 우클릭 → ID 복사. 둘 다 없으면 켜지지 않는다.
TEAM_CHANNEL_ID=
TEAM_OWNER_ID=

# 팀 채널의 웹후크 URL (채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사). 팀원이 자기 이름으로 올릴 때 쓴다.
TEAM_WEBHOOK_URL=

# Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 서비스 계정 키 파일 (로컬에서 gcloud auth application-default login을 했다면 비워둬도 됨)
GOOGLE_APPLICATION_CREDENTIALS=

# 모델 (Vertex 모델 ID). 404가 나면 Model Garden에서 정확한 ID를 확인해서 바꾼다.
TEAM_PM_MODEL=claude-opus-5-5
TEAM_RESEARCH_MODEL=gemini-3.8-flash
TEAM_WRITER_MODEL=claude-opus-5-5
TEAM_REVIEW_MODEL=gemini-3.1-pro-preview
TEAM_DESIGN_MODEL=gemini-3-pro-image-preview
